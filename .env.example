PORT=4000
# Toujours préciser le nom de la base dans l’URI (ex. /bambino), sinon les données peuvent aller dans "test"
# et l’API ne verra aucun hôpital. Même URI pour `npm run seed` et `npm run dev`.
MONGODB_URI=mongodb://127.0.0.1:27017/bambino
JWT_SECRET=change-me-to-a-long-random-string
# Origines autorisées (navigateur). En dev, localhost / 127.0.0.1 sur n’importe quel port est aussi accepté si NODE_ENV n’est pas production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Laravel → Mongo migration (npm run migrate:laravel)
# If backend/.env has DB_CONNECTION=mysql, use mysql below (SQLite file may be empty).
# LARAVEL_DB_DRIVER=sqlite
# LARAVEL_SQLITE_PATH=../backend/database/database.sqlite
# LARAVEL_DB_DRIVER=mysql
# LARAVEL_MYSQL_HOST=127.0.0.1
# LARAVEL_MYSQL_PORT=3306
# LARAVEL_MYSQL_USER=root
# LARAVEL_MYSQL_PASSWORD=
# LARAVEL_MYSQL_DATABASE=bambino
